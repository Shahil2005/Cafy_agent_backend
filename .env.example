# ProductBackend environment variables
# Copy values into `.env` and Vercel. Never commit secrets.

# Local browser origins localhost/127.0.0.1 on ports 3000,5173,5174,5175,5199
# are allowed automatically outside production. For another frontend origin/port,
# set this existing comma-separated override and restart the backend.
# FRONTEND_URL=http://localhost:5176,http://127.0.0.1:5176

# --- Lifecycle email (Resend) ---
# Master kill switch. Leave false until DNS (SPF/DKIM/DMARC) and Resend are ready.
EMAIL_SENDING_ENABLED=false

# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender. Must match a domain verified in Resend (cafy.careers).
EMAIL_FROM=Cafy <admin@cafy.careers>
EMAIL_REPLY_TO=admin@cafy.careers

# HMAC secret for unsubscribe tokens. Generate with: openssl rand -hex 32
EMAIL_UNSUBSCRIBE_SECRET=

# Optional comma-separated allowlist. Empty = send to all eligible users when enabled.
# Use your inbox for staging, e.g. you@cafy.careers
EMAIL_ALLOWLIST=

# Public URL of this API (unsubscribe links in emails).
EMAIL_API_PUBLIC_URL=https://api.cafy.careers

# Marketing site origin for redirects and preference pages.
COMPANY_SITE_URL=https://www.cafy.careers

# Hosted email images (logo/heroes). Defaults match CompanySite /emails/*.
EMAIL_ASSET_BASE_URL=https://www.cafy.careers/emails

# Hours-scale delay before the marketing follow-up (status mail goes immediately).
# Default is 4 hours (14400000 ms).
# EMAIL_OFFER_DELAY_MS=14400000

# --- AI ---
# Local backend loads `.env` in ProductBackend-main (not `.env.local`).
# Server-only shared key for job-search chat and existing career/communications AI.
# Leave empty until ready; chat still provides deterministic catalogue search.
GEMINI_API_KEY=

# Web research uses this existing Gemini setup. Direct employer-site reads
# require no additional API key or jobs-data subscription.

# Existing model settings; these defaults are already used when omitted.
AI_PRIMARY_MODEL=gemini-2.5-flash
AI_GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Gemini key used only by the extension autofill feature (autofill_profile / autofill_fill).
AUTOFILL_GEMINI_API_KEY=
# CAFY chat agent (agent_turn, agent_cv_profile): own key so its Gemini cost is tracked separately
AGENT_GEMINI_API_KEY=
# Chat agent job ranking: 1 = the fast ranking (supabase/testing/agent_match_jobs_fast.sql), with automatic
# fallback to the exact ranking. Set only after scripts/agent/compareFastRank.ts prints RESULT: PASS.
AGENT_FAST_RANK=
# Extension autofill limits (enforced only when BILLING_ENABLED=true)
# Free plan: autofills for the account's lifetime. Full Premium: autofills per day (UK time).
FREE_AUTOFILL_LIFETIME_LIMIT=5
PREMIUM_AUTOFILL_DAILY_LIMIT=20

# Realtime Database (account delete clears presence/{uid})
# Optional: the chat agent reads jobs, companies and pay from this project, read-only (agent/jobs/db.ts).
# Unset = the agent uses SUPABASE_URL with its database ranking function.
AGENT_JOBS_SUPABASE_URL=
AGENT_JOBS_SUPABASE_SERVICE_ROLE_KEY=
FIREBASE_DATABASE_URL=https://<project>-default-rtdb.<region>.firebasedatabase.app
