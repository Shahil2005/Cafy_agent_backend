{
    "name": "cafy-backend",
    "version": "1.0.0",
    "description": "Backend for Cafy using Express and Firebase Admin",
    "main": "dist/server.js",
    "scripts": {
        "build": "tsc",
        "vercel-build": "npm run build",
        "start": "node dist/server.js",
        "dev": "nodemon",
        "typecheck": "tsc --noEmit",
        "ingest:soc": "ts-node scripts/ingestSocOccupations.ts",
        "ingest:soc:gte": "ts-node scripts/ingestSocOccupationsGte.ts",
        "test:ireland-sponsorship": "node --require ts-node/register --test jobs-portal/irelandSponsorship.test.ts",
        "test:directory-ids": "node --require ts-node/register --test jobs-portal/directoryIds.test.ts",
        "test:agent": "node --require ts-node/register --test agent/*.test.ts",
        "eval:agent": "ts-node --transpile-only scripts/agent/evalAgent.ts",
        "test:jobs-chat": "node --require ts-node/register --test jobs-portal/chat*.test.ts",
        "test:career-matches": "node --require ts-node/register --test jobs-portal/careerMatch*.test.ts jobs-portal/chatCareerMatch*.test.ts",
        "sync:directory-employers": "ts-node --transpile-only scripts/syncDirectoryEmployers.ts",
        "revenue": "ts-node --transpile-only scripts/monthlyNetRevenue.ts"
    },
    "dependencies": {
        "@sentry/node": "10.55.0",
        "@supabase/supabase-js": "2.99.1",
        "@upstash/redis": "1.38.0",
        "cookie-parser": "^1.4.7",
        "cors": "2.8.5",
        "dotenv": "16.4.5",
        "express": "4.19.2",
        "express-mongo-sanitize": "2.2.0",
        "express-rate-limit": "8.5.2",
        "firebase-admin": "13.10.0",
        "helmet": "8.1.0",
        "hpp": "0.2.3",
        "ioredis": "5.11.0",
        "pdf-parse": "^1.1.4",
        "rate-limit-redis": "5.0.0",
        "stripe": "22.1.1",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@huggingface/transformers": "^4.2.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "2.8.17",
        "@types/express": "4.17.21",
        "@types/express-mongo-sanitize": "1.3.2",
        "@types/hpp": "0.2.7",
        "@types/ioredis": "5.0.0",
        "@types/node": "20.12.7",
        "@types/pdf-parse": "^1.1.5",
        "nodemon": "3.1.0",
        "ts-node": "10.9.2",
        "typescript": "5.4.5"
    }
}
